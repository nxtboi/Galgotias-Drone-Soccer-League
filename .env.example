# ==============================================================================
# GDSL 2026 Tournament Portal - Environment Configuration Template
# Copy this file to .env on your VPS and update the values as needed
# ==============================================================================

# Server Runtime Configuration
NODE_ENV=production
PORT=3000

# Public domain URL (used for absolute links and canonical headers)
PUBLIC_URL=https://gdsl.example.com

# Optional Admin Credentials / Secret Salt
# Default fallback admin credentials are built into the app for GCDIS staff:
# Username: admin / Password: gdsl2026password / Security Passcode: GCDIS-SUPER-ADMIN-2026
ADMIN_SECRET_KEY=change_this_to_a_random_32_character_secret_string

# Google Sheets Sync (Optional)
# If integrating with Google Sheets API for cloud mirror:
# GOOGLE_SHEETS_SPREADSHEET_ID=
