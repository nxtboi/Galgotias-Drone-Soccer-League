# ==============================================================================
# GDSL 2026 Tournament Portal - Environment Configuration Template
# Copy this file to .env on your VPS and update the values as needed
# ==============================================================================

# Server Runtime Configuration
NODE_ENV=production
PORT=3000

# Public domain URL (used for absolute links and canonical headers)
PUBLIC_URL=https://gdsl.example.com

# Admin login (REQUIRED in production - admin sign-in is disabled until ADMIN_PASSWORD is set)
# Use a long, unique password (at least 8 characters; 16+ recommended).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Secret used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left empty, a random secret is used and everyone is logged out on each restart.
ADMIN_SECRET_KEY=

# ------------------------------------------------------------------------------
# Payment-details emails: sent from ONE official address to the team that requests them.
# Leave SMTP_HOST empty to only record requests (admins then email teams manually).
# Gmail / Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<that address>,
#   SMTP_PASS=<16-character App Password> (needs 2-Step Verification on that account).
# MAIL_FROM must be the same address as SMTP_USER (or a verified "Send mail as" alias).
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GDSL 2026 Secretariat <official-address@gcdis.in>"

# Organiser payment details included in the email (rows left empty are omitted)
PAYMENT_ACCOUNT_NAME=
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_IFSC=
PAYMENT_BRANCH=
PAYMENT_UPI_ID=
# Shown as the contact line and used as Reply-To
PAYMENT_CONTACT_EMAIL=
PAYMENT_CONTACT_PHONE=

# ------------------------------------------------------------------------------
# "Continue with Google" for TEAM LEADERS (captains) only. Leave empty to hide the button.
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud Console and add your
# site to "Authorized JavaScript origins" (e.g. https://your-domain and http://localhost:3000).
# You can reuse the GCDIS website's client ID if you add this portal's origin to it.
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
# Optional: only allow Google Workspace accounts from these domains (comma-separated)
# GOOGLE_ALLOWED_HOSTED_DOMAINS=galgotiasuniversity.edu.in

# Google Sheets Sync (Optional)
# If integrating with Google Sheets API for cloud mirror:
# GOOGLE_SHEETS_SPREADSHEET_ID=
